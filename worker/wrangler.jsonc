  "main": "index.mjs",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "assets": {"directory": ".assets", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "CHAT", "class_name": "ArchiveChat"}]},
