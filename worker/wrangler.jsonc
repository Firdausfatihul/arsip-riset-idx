  "vars": {
    "CHAT_ALLOWED_ORIGINS": "https://arsip.seekingomega.capital",
    "CHAT_DAILY_REQUESTS": "100",
    "CHAT_HOURLY_PER_IP": "10"
  },
  "observability": {"enabled": false}
}
