# Salin ke .env.chat (diabaikan Git, izin 600). Hanya dua key ini yang dipakai server dan dikirim `vps.mjs push`.
# Key datacat (quant.renr.ai) untuk mode agen; kosong = mode agen disembunyikan.
DATACAT_API_KEY=
# Secret acak untuk hash penanda klien di statistik pertanyaan (bukan token login).
CHAT_METRICS_TOKEN=
